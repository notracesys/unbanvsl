
{
  "entities": {
    "VSLMetric": {
      "title": "VSL Metric",
      "description": "Métricas de visualização da VSL para análise de retenção.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "visitorId": { "type": "string" },
        "watchTime": { "type": "number", "description": "Segundos assistidos" },
        "totalDuration": { "type": "number", "description": "Duração total do vídeo" },
        "percentage": { "type": "number", "description": "Porcentagem concluída" },
        "lastMilestone": { "type": "number", "enum": [0, 25, 50, 75, 90, 100] },
        "device": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["visitorId", "watchTime", "createdAt"]
    }
  },
  "auth": {
    "providers": ["google.com", "anonymous"]
  },
  "firestore": {
    "/metrics/{metricId}": {
      "schema": "VSLMetric",
      "description": "Registros de eventos de visualização da VSL."
    }
  }
}
