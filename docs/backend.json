
{
  "entities": {
    "Scan": {
      "title": "Scan",
      "description": "Uma sessão de análise de exposição digital.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "identifier": { "type": "string", "description": "E-mail, telefone ou username analisado" },
        "type": { "type": "string", "enum": ["email", "phone", "username"] },
        "status": { "type": "string", "enum": ["queued", "searching", "analyzing", "complete", "failed"] },
        "exposureScore": { "type": "number", "minimum": 0, "maximum": 100 },
        "findingsCount": { "type": "number" },
        "isPaid": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "expiresAt": { "type": "string", "format": "date-time" }
      },
      "required": ["identifier", "type", "status", "createdAt"]
    },
    "Finding": {
      "title": "Finding",
      "description": "Uma ocorrência confirmada de exposição.",
      "type": "object",
      "properties": {
        "scanId": { "type": "string" },
        "type": { "type": "string", "description": "Tipo do dado exposto" },
        "sourceUrl": { "type": "string" },
        "sourceTitle": { "type": "string" },
        "sourceDomain": { "type": "string" },
        "confidenceScore": { "type": "number", "minimum": 0, "maximum": 100 },
        "riskLevel": { "type": "string", "enum": ["low", "moderate", "high", "critical"] },
        "snippet": { "type": "string" },
        "verifiedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["scanId", "type", "sourceUrl", "confidenceScore", "riskLevel"]
    }
  },
  "auth": {
    "providers": ["google.com", "anonymous"]
  },
  "firestore": {
    "/scans/{scanId}": {
      "schema": "Scan",
      "description": "Coleção de scans realizados."
    },
    "/scans/{scanId}/findings/{findingId}": {
      "schema": "Finding",
      "description": "Resultados detalhados de cada scan."
    }
  }
}
