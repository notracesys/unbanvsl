
{
  "entities": {
    "VSLMetric": {
      "title": "VSL Metric",
      "description": "Métricas detalhadas de visualização para análise de funil e retenção.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "visitorId": { "type": "string" },
        "watchTime": { "type": "number", "description": "Segundos assistidos no vídeo" },
        "totalDuration": { "type": "number" },
        "percentage": { "type": "number" },
        "device": { "type": "string", "enum": ["mobile", "desktop"] },
        "clickedCTA": { "type": "boolean" },
        "started": { "type": "boolean" },
        "completed": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["visitorId", "updatedAt"]
    }
  },
  "auth": {
    "providers": ["anonymous"]
  },
  "firestore": {
    "/metrics/{metricId}": {
      "schema": "VSLMetric",
      "description": "Coleção central de rastreamento de leads da VSL."
    }
  }
}
