{
  "entities": {
    "Scan": {
      "title": "Scan",
      "description": "Uma sessão de análise de inteligência de dados Atlas.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "query": { "type": "string", "description": "O dado consultado pelo usuário" },
        "type": { "type": "string", "enum": ["email", "phone", "cpf", "cnpj", "name", "username", "other"] },
        "status": { "type": "string", "enum": ["processing", "completed", "failed"] },
        "exposureScore": { "type": "number", "minimum": 0, "maximum": 100 },
        "findingsCount": { "type": "number" },
        "isPaid": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["query", "type", "status", "createdAt"]
    },
    "Finding": {
      "title": "Finding",
      "description": "Uma ocorrência de dado localizada em fonte pública.",
      "type": "object",
      "properties": {
        "scanId": { "type": "string" },
        "type": { "type": "string", "description": "Categoria do dado (Ex: Profissional, Jurídico)" },
        "source": { "type": "string" },
        "relevance": { "type": "string", "enum": ["low", "moderate", "high"] },
        "snippet": { "type": "string" },
        "verifiedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["scanId", "type", "source", "relevance"]
    }
  },
  "auth": {
    "providers": ["google.com", "anonymous"]
  },
  "firestore": {
    "/scans/{scanId}": {
      "schema": "Scan",
      "description": "Coleção de análises Atlas realizadas."
    },
    "/scans/{scanId}/findings/{findingId}": {
      "schema": "Finding",
      "description": "Resultados detalhados de cada análise."
    }
  }
}